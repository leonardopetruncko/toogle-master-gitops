          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{k8s_namespace_name=~\"toogle-master|observability\"} |~ \"(?i)(erro|error|exception|chaos|runbook|rollout)\"",
