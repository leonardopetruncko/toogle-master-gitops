    {
      "type": "stat",
      "id": 6,
      "title": "CPU do cluster",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
